{
  "description": "Optional lifecycle hooks for this workspace.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/protect-files.ts\"",
            "statusMessage": "Checking Bash command"
          }
        ]
      }
    ]
  }
}
