{
  // Lint rules for agent-written code. A rule file: agents read it, humans change it.
  // Exceptions go here, in an override with a reason, never in a disable comment.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vitest"],
  "categories": { "correctness": "error" },
  "ignorePatterns": [".claude/worktrees/**", ".worktrees/**"],
  "rules": {
    // AGENTS.md: "No default exports, except in tool config files."
    "no-restricted-exports": [
      "error",
      {
        "restrictDefaultExports": {
          "direct": true,
          "named": true,
          "defaultFrom": true,
          "namedFrom": true,
          "namespaceFrom": true
        }
      }
    ],
    // The two ways to silence the type checker instead of fixing the type.
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-ignore": true, "ts-expect-error": true, "ts-nocheck": true }
    ],
    // The two ways to make a failing test stop failing without fixing it.
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }]
  },
  "overrides": [
    { "files": ["*.config.ts"], "rules": { "no-restricted-exports": "off" } },
    { "files": ["src/**"], "rules": { "no-console": "error" } },
    // ADR 0002: src/cli/ is the only layer that does I/O, so it may write to the console.
    { "files": ["src/cli/**"], "rules": { "no-console": "off" } },    
    { "files": ["src/average.test.ts"], "rules": { "no-sparse-arrays": "off" } }
  ]
}
